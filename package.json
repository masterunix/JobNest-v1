{
  "name": "jobnest",
  "version": "1.0.0",
  "description": "A full-stack job application platform",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd api && npm install && cd ../frontend && npm install",
    "server": "npm run dev --prefix api",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "npm run server",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview"
  },
  "keywords": [
    "job",
    "application",
    "fullstack",
    "react",
    "node",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^7.0.2"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  }
}
